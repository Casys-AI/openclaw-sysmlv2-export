{
  "imports": {
    "@logtape/redaction": "jsr:@logtape/redaction@2.4.2",
    "diff": "npm:diff@9.0.0",
    "elkjs": "npm:elkjs@0.9.3",
    "oxigraph/web": "npm:oxigraph@0.5.12/web.js",
    "sparqljs": "npm:sparqljs@3.7.4",
    "@types/sparqljs": "npm:@types/sparqljs@3.1.12"
  },
  "tasks": {
    "collect": "deno run --cached-only --allow-read --allow-write cli.ts collect",
    "export": "deno run --cached-only --allow-read --allow-write cli.ts export",
    "doctor": "deno run --cached-only --allow-read cli.ts doctor",
    "diff": "deno run --cached-only --allow-read cli.ts diff",
    "check": "deno check --cached-only src/ cli.ts plugin/core.ts test/integration/ test/support/ test/update-golden.ts",
    "test": "deno test --cached-only --allow-read --allow-write --allow-env=SYSML_TOOLKIT_WASM_ARCHIVE,OPENSYSML_ARCHIVE,TMPDIR,TMP,TEMP src/ test/integration/",
    "test:toolkit": "deno test --cached-only --allow-read --allow-write --allow-env=SYSML_TOOLKIT_WASM_ARCHIVE,TMPDIR,TMP,TEMP test/integration/toolkit_test.ts test/integration/toolkit_install_test.ts",
    "plugin:build": "deno check --cached-only plugin/core.ts src/adapters/out/sysml-toolkit/worker.ts && deno bundle --deny-import --platform=node -o plugin/core.mjs plugin/core.ts && deno bundle --deny-import --platform=node -o plugin/toolkit-worker.mjs src/adapters/out/sysml-toolkit/worker.ts && deno run --cached-only --allow-read --allow-write scripts/package-ape.ts",
    "test:opensysml": "deno test --cached-only --allow-read --allow-write --allow-run --allow-env=SYSML_TOOLKIT_WASM_ARCHIVE,OPENSYSML_ARCHIVE,TMPDIR,TMP,TEMP test/integration/opensysml_test.ts"
  },
  "fmt": {
    "exclude": [
      "test/fixtures",
      "test/golden",
      "plugin/core.mjs",
      "plugin/THIRD_PARTY_NOTICES.md",
      "plugin/toolkit-worker.mjs"
    ]
  },
  "lint": {
    "exclude": [
      "test/fixtures",
      "test/golden",
      "plugin/core.mjs",
      "plugin/toolkit-worker.mjs"
    ]
  }
}

# code: GRANT_WIDENS_PARENT
# severity: warning
# pattern: S3
# finding: present
# context: This agent has no unapproved host exec but can delegate, directly or through other agents, to {related}, whose builtin exec runs on the host with effective security full and ask off.
# recovery: Review the delegated execution boundary and attenuate grants or require approval at the host execution endpoint.

PREFIX ape: <urn:ase:ape:v1:>

SELECT DISTINCT ?agentId ?relatedAgentId WHERE {
  GRAPH <urn:ase:ape:v1:view:agents> {
    ?agent ape:agentId ?agentId .
    ?target ape:agentId ?relatedAgentId .
  }
  GRAPH <urn:ase:ape:v1:view:exec> {
    ?agent ape:unapprovedHostExec false .
    ?target ape:unapprovedHostExec true .
    FILTER NOT EXISTS { ?agent ape:unapprovedHostExec true . }
  }
  GRAPH <urn:ase:ape:v1:view:delegation> { ?agent ape:delegatesTo+ ?target . }
}
ORDER BY ?agentId

# code: UNREACHABLE_OPERATOR
# severity: warning
# pattern: 4.2
# finding: absent
# context: No modeled channel binding, scheduled case, hook, incoming delegation from another agent or enabled messaging target reaches this agent. This is structural reachability, not proof of runtime isolation.
# recovery: Review the agent's intended entry or supervision path and model it explicitly.

PREFIX ape: <urn:ase:ape:v1:>

SELECT DISTINCT ?agentId WHERE {
  GRAPH <urn:ase:ape:v1:view:agents> { ?agent ape:agentId ?agentId . }
  FILTER NOT EXISTS {
    GRAPH <urn:ase:ape:v1:view:entries> { ?agent ape:reachedBy ?entry . }
  }
  FILTER NOT EXISTS {
    GRAPH <urn:ase:ape:v1:view:delegation> {
      ?other ape:delegatesTo ?agent .
      FILTER(?other != ?agent)
    }
  }
  FILTER NOT EXISTS {
    GRAPH <urn:ase:ape:v1:view:messaging> { ?policy ape:messageTarget ?agent . }
  }
}
ORDER BY ?agentId

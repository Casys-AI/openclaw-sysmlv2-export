PREFIX ase: <urn:ase:vocab:>
PREFIX prop: <urn:ase:vocab:prop:>
PREFIX meta: <urn:ase:metaclass:>
PREFIX ape: <urn:ase:ape:v1:>

CONSTRUCT {
  ?agent ape:agentId ?agentId ; ape:definition ?agentType ;
    ape:source ?idFeature ; ape:scope ?scope .
} WHERE {
  GRAPH ?build {
    ?agent a meta:PartUsage ; prop:definition ?agentType ; prop:owner+ ?scope .
    ?agentType (prop:ownedSpecialization/prop:general)+ ?base ;
      prop:ownedMember ?idFeature .
    ?base ase:qualifiedName "OpenClawImport::OpenClawAgent" .
    ?idFeature prop:ownedRedefinition/prop:redefinedFeature/ase:qualifiedName
      "OpenClawImport::OpenClawAgent::id" ;
      prop:ownedMember/prop:value ?agentId .
    ?scope a meta:Package ; prop:owner ?root .
    ?root a meta:Namespace .
    FILTER(isLiteral(?agentId))
  }
  FILTER(STRSTARTS(STR(?build), "urn:ase:build:"))
}

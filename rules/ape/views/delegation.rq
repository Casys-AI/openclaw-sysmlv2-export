PREFIX ase: <urn:ase:vocab:>
PREFIX prop: <urn:ase:vocab:prop:>
PREFIX meta: <urn:ase:metaclass:>
PREFIX ape: <urn:ase:ape:v1:>

CONSTRUCT {
  ?from ape:delegatesTo ?to .
  ?source ape:from ?from ; ape:to ?to ; ape:source ?source ;
    ape:wildcardTargets ?wildcard .
} WHERE {
  GRAPH <urn:ase:ape:v1:view:agents> {
    ?from ape:agentId ?fromId .
    ?to ape:agentId ?toId .
  }
  {
    GRAPH ?build {
      ?source a meta:ConnectionUsage ;
        prop:definition/ase:qualifiedName "OpenClawImport::DelegationRule" ;
        prop:sourceFeature ?from ; prop:targetFeature ?to .
    }
  } UNION {
    GRAPH <urn:ase:ape:v1:view:agents> {
      ?from ape:scope ?scope .
      ?to ape:scope ?scope .
    }
    GRAPH ?build {
      ?source prop:definition/ase:qualifiedName "OpenClawImport::DelegationPolicy" ;
        prop:ownedMember ?fromFeature, ?wildcardFeature ; prop:owner+ ?scope .
      ?fromFeature prop:ownedRedefinition/prop:redefinedFeature/ase:qualifiedName
        "OpenClawImport::DelegationPolicy::fromAgent" ;
        prop:ownedMember/prop:referent ?from .
      ?wildcardFeature prop:ownedRedefinition/prop:redefinedFeature/ase:qualifiedName
        "OpenClawImport::DelegationPolicy::wildcardTargets" ;
        prop:ownedMember/prop:value true .
    }
    BIND(true AS ?wildcard)
  }
  FILTER(STRSTARTS(STR(?build), "urn:ase:build:"))
}

{
  "name": "@casys/openclaw-sysmlv2-export",
  "version": "0.3.1",
  "private": true,
  "description": "Export an OpenClaw instance as SysML v2 for Assembly, with optional inferred procedures and a version viewer.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "sysml",
    "sysml-v2",
    "mbse",
    "model-based-systems-engineering",
    "assembly",
    "agents"
  ],
  "homepage": "https://github.com/Casys-AI/openclaw-sysmlv2-export#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casys-AI/openclaw-sysmlv2-export.git",
    "directory": "plugin"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "index.mjs",
    "core.mjs",
    "toolkit-worker.mjs",
    "oxigraph_bg.wasm",
    "distribution.json",
    "toolkit/",
    "rules/ape/*.ttl",
    "rules/openclaw/*.ttl",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.9"
  },
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.10.9",
      "minGatewayVersion": "2026.10.9"
    },
    "build": {
      "openclawVersion": "2026.10.9",
      "pluginSdkVersion": "2026.10.9"
    }
  }
}
